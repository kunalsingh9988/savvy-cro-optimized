{% comment %}
  Savvy wordmark with spark marks.
  @param [white] - {boolean} render the white variant
{% endcomment %}
<span class="brand{% if white %} brand-white{% endif %}" aria-label="Savvy"><span class="spark one" aria-hidden="true">✦</span>savvy<span class="spark two" aria-hidden="true">✦</span><span class="spark three" aria-hidden="true">✦</span><sup>™</sup></span>
