{% comment %}
  Savvy brand fonts. Faces mirror the prototype's fonts.css — family names match
  the generated design stylesheet (sv-design.css) exactly.
{% endcomment %}
{% style %}
  @font-face{font-family:"filson-pro:Black";src:url({{ 'filson-900.woff2' | asset_url }}) format("woff2");font-display:swap}
  @font-face{font-family:"Filson";src:url({{ 'filson-900.woff2' | asset_url }}) format("woff2");font-weight:900;font-display:swap}
  @font-face{font-family:"filson-pro:Extra_Bold";src:url({{ 'filson-800.woff2' | asset_url }}) format("woff2");font-display:swap}
  @font-face{font-family:"Filson";src:url({{ 'filson-800.woff2' | asset_url }}) format("woff2");font-weight:800;font-display:swap}
  @font-face{font-family:"filson-pro:Bold";src:url({{ 'filson-700.woff2' | asset_url }}) format("woff2");font-display:swap}
  @font-face{font-family:"Filson";src:url({{ 'filson-700.woff2' | asset_url }}) format("woff2");font-weight:700;font-display:swap}
  @font-face{font-family:"filson-pro:Medium";src:url({{ 'filson-500.woff2' | asset_url }}) format("woff2");font-display:swap}
  @font-face{font-family:"Filson";src:url({{ 'filson-500.woff2' | asset_url }}) format("woff2");font-weight:500;font-display:swap}
  @font-face{font-family:"filson-pro:Regular";src:url({{ 'filson-400.woff2' | asset_url }}) format("woff2");font-display:swap}
  @font-face{font-family:"Filson";src:url({{ 'filson-400.woff2' | asset_url }}) format("woff2");font-weight:400;font-display:swap}
  @font-face{font-family:"filson-pro:Light";src:url({{ 'filson-300.woff2' | asset_url }}) format("woff2");font-display:swap}
  @font-face{font-family:"Filson";src:url({{ 'filson-300.woff2' | asset_url }}) format("woff2");font-weight:300;font-display:swap}
  @font-face{font-family:"Kefir:Black";src:url({{ 'Kefir-Black.woff2' | asset_url }}) format("woff2");font-display:swap}
  @font-face{font-family:"Kefir:Extra_Bold";src:url({{ 'Kefir-ExtraBold.woff2' | asset_url }}) format("woff2");font-display:swap}
  @font-face{font-family:"Kefir:Bold";src:url({{ 'Kefir-Bold.otf' | asset_url }}) format("opentype");font-display:swap}
  @font-face{font-family:"Kefir:Semi_Bold";src:url({{ 'kefir-demi-bold-webfont.woff2' | asset_url }}) format("woff2");font-display:swap}
  @font-face{font-family:"Figtree:Regular";src:url({{ 'Figtree-Regular.woff2' | asset_url }}) format("woff2");font-display:swap}
  @font-face{font-family:"Figtree:Bold";src:url({{ 'Figtree-Bold.woff2' | asset_url }}) format("woff2");font-display:swap}
  @font-face{font-family:"Verveine:Regular";src:url({{ 'Verveine-Regular.woff2' | asset_url }}) format("woff2");font-display:swap}
  @font-face{font-family:"Inter:Regular";src:url({{ 'Inter-Regular.ttf' | asset_url }}) format("truetype");font-display:swap}
  @font-face{font-family:"Inter:Semi_Bold";src:url({{ 'Inter-SemiBold.ttf' | asset_url }}) format("truetype");font-display:swap}
{% endstyle %}
