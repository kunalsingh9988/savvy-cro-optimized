{% comment %}
  Section contract.
  Savvy social proof strip: photo collages flanking the Stay Connected callout
  with a rotated handle chip and shop CTA.
  @example Homepage, above the footer.
{% endcomment %}

<div class="social-section" style="--sv-social-wave:url({{ '200742f4-9b7b-47e4-b3ea-6c244e2ab6e6.svg' | asset_url }})">
  <div class="social-wave" aria-hidden="true"></div>
  <div class="social-collage social-collage-left">
    {%- if section.settings.left_image -%}
      {{ section.settings.left_image | image_url: width: 1400 | image_tag: '', 'lazy' }}
    {%- else -%}
      <img src="{{ 'savvy-53-1413x720.webp' | asset_url }}" alt="Savvy coffee moments and recipes" loading="lazy" width="1413" height="720">
    {%- endif -%}
  </div>
  <div class="social-copy">
    <span class="social-handle">{{ section.settings.handle }}</span>
    <h2>{{ section.settings.heading }}</h2>
    <p>{{ section.settings.subtitle }}</p>
    <a class="social-shop" href="{{ section.settings.cta_link | default: '/collections/all' }}">{{ section.settings.cta_label }}</a>
  </div>
  <div class="social-collage social-collage-right">
    {%- if section.settings.right_image -%}
      {{ section.settings.right_image | image_url: width: 1400 | image_tag: '', 'lazy' }}
    {%- else -%}
      <img src="{{ 'savvy-54-1413x720.webp' | asset_url }}" alt="Savvy drinks and flavors" loading="lazy" width="1413" height="720">
    {%- endif -%}
  </div>
</div>

{% schema %}
{
  "name": "SV Social",
  "class": "sv-design",
  "settings": [
    { "type": "image_picker", "id": "left_image", "label": "Left collage image" },
    { "type": "image_picker", "id": "right_image", "label": "Right collage image" },
    { "type": "text", "id": "handle", "label": "Handle chip", "default": "@savvycoffee" },
    { "type": "html", "id": "heading", "label": "Heading", "default": "Stay<br>Connected" },
    { "type": "text", "id": "subtitle", "label": "Subtitle", "default": "Sip by sip!" },
    { "type": "text", "id": "cta_label", "label": "CTA label", "default": "Shop Now" },
    { "type": "url", "id": "cta_link", "label": "CTA link" }
  ],
  "presets": [{ "name": "SV Social" }]
}
{% endschema %}
